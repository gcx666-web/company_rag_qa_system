# 环境变量示例：复制为 .env 后按需修改（.env 已被 .gitignore 忽略）

# ===== 文件上传 =====
# 单文件最大字节数，默认 50MB
MAX_FILE_SIZE=52428800
# 是否开启 SHA-256 内容去重（秒传）
UPLOAD_DEDUP_ENABLED=true
# 上传登记表路径（默认 data/upload_registry.sqlite3）
# UPLOAD_REGISTRY_DB=D:\work\company_rag_qa_system\data\upload_registry.sqlite3

# ===== 向量模型：auto / online / offline =====
# auto   ：有在线密钥时在线，否则离线
# online ：强制在线，缺少密钥会报错
# offline：强制离线，使用本地模型且不联网
EMBEDDING_MODE=auto

# 在线向量模型（OpenAI 兼容接口）
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# 显式指定向量维度；留空则使用模型默认维度
# EMBEDDING_DIMENSION=1024

# 离线向量模型（需提前下载到 HuggingFace 缓存或本地目录）
OFFLINE_EMBEDDING_MODEL=BAAI/bge-small-zh
# 也可直接指向本地模型目录，优先级更高
# OFFLINE_EMBEDDING_DIR=D:\models\bge-small-zh
OFFLINE_EMBEDDING_DEVICE=cpu
# 只读本地缓存，禁止 HuggingFace 联网检查
OFFLINE_EMBEDDING_LOCAL_ONLY=true
# 离线模型维度提示值（bge-small-zh 为 512）；换模型时同步修改
OFFLINE_EMBEDDING_DIMENSION=512
# 本地推理批大小
EMBEDDING_BATCH_SIZE=32
# 启动时预热向量模型（默认关闭，避免离线加载拖慢启动）
EMBEDDING_WARMUP_ON_STARTUP=false

# ===== 向量缓存（内存 LRU + SQLite） =====
EMBEDDING_CACHE_ENABLED=true
# EMBEDDING_CACHE_DIR=D:\work\company_rag_qa_system\data\cache\embeddings
EMBEDDING_CACHE_MAX_ITEMS=2048
# 磁盘缓存有效期（秒），0 表示永不过期
EMBEDDING_CACHE_TTL_SECONDS=0

# ===== 大模型供应商（至少配置一个） =====
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://api.siliconflow.cn/v1
ZHIPU_MODEL=zai-org/GLM-5.3-Flash

QWEN_API_KEY=
QWEN_BASE_URL=https://api.siliconflow.cn/v1
QWEN_MODEL=Qwen/Qwen3.8-27B

SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=Qwen/Qwen3-Chat-0.6B

# 默认供应商名（zhipu / qwen / siliconflow），也可写具体模型名
DEFAULT_LLM_MODEL=zhipu
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
LLM_TIMEOUT_SECONDS=120

# ===== 检索 / 向量库 =====
TOP_K=5
# cosine / l2 / ip
CHROMA_DISTANCE=cosine

# ===== 前端与跨域 =====
# 前端构建产物目录；存在 index.html 时 FastAPI 直接托管
# FRONTEND_DIST=D:\work\company_rag_qa_system\frontend\dist
# Vite 开发服务器跨域白名单（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
